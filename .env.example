# Copy to .env (gitignored). OpenAI-compatible gateway for pi sessions.
# Models use provider/modelId. TRACE_DISTILLER_PROVIDER names the gateway
# (or is derived from the first MODEL_* slash prefix). Mint/Macaron is one
# possible OpenAI-compatible gateway config, not required.
TRACE_DISTILLER_API_BASE=https://example.com/v1
TRACE_DISTILLER_API_KEY=
TRACE_DISTILLER_PROVIDER=your-provider
TRACE_DISTILLER_MODEL_HOLE_A=provider/modelId
TRACE_DISTILLER_MODEL_HOLE_B=provider/modelId
TRACE_DISTILLER_MODEL_L4=provider/modelId
# Optional: pi registerProvider api type (default openai-completions).
# Known: openai-completions, mistral-conversations, openai-responses,
# azure-openai-responses, openai-codex-responses, anthropic-messages,
# bedrock-converse-stream, google-generative-ai, google-vertex.
# Other strings pass through to registerProvider.
# TRACE_DISTILLER_API_TYPE=openai-completions
# Optional: hard timeout per pi session call (ms). Default 120000.
# For long-only mint (bench --with-l4 --bin long) use >=300000.
# TRACE_DISTILLER_SESSION_TIMEOUT_MS=120000
# TRACE_DISTILLER_SESSION_TIMEOUT_MS=300000
# Optional: Hole A vector efficiency embeddings (bench-only; never online stop).
# Default = deterministic_hash (no network). Do NOT reuse TRACE_DISTILLER_API_KEY.
# TRACE_DISTILLER_EMBEDDING_PROVIDER=deterministic_hash
# TRACE_DISTILLER_EMBEDDING_PROVIDER=openai
# TRACE_DISTILLER_EMBEDDING_URL=https://api.openai.com/v1/embeddings
# TRACE_DISTILLER_EMBEDDING_API_KEY=
# TRACE_DISTILLER_EMBEDDING_MODEL=text-embedding-3-small
# Hole A decisions (ADR-0017). Candidate pool + sparse sampling stay algorithmic.
# Unset: jev when skeletonPass has no SessionBackend (live if a key is set,
# FakeJevClient otherwise — no network). Injected FakeSessionBackend / --fake-l4
# keeps the pi Hole A path unless this is jev.
#   jev: TypeSafe systemOne (Choice / Score / Noul). SDK posts {base}/v1/systemone.
#        Base: TRACE_DISTILLER_JEV_BASE, else TRACE_DISTILLER_API_BASE
#        (one trailing /v1 stripped), else https://api.typesafe.ai.
#        mint-alpha: leave JEV_BASE unset. API_BASE=https://mint-alpha.macaron.im/v1
#        becomes POST https://mint-alpha.macaron.im/v1/systemone, model id jev.
#   pi:  generative Hole A via TRACE_DISTILLER_MODEL_HOLE_A.
# TRACE_DISTILLER_HOLE_A_DECISION=jev
# Key order: TRACE_DISTILLER_JEV_API_KEY, then TYPESAFE_API_KEY, then TRACE_DISTILLER_API_KEY.
# TRACE_DISTILLER_JEV_API_KEY=
# TYPESAFE_API_KEY=
# TRACE_DISTILLER_JEV_BASE=
# TRACE_DISTILLER_JEV_MODEL=jev   # mint model id; pin jev-latest or jev-1.13.0 on api.typesafe.ai
# intent_v0 v1 is a scenario template, not generative prose. Hole A still does not emit keep/collapse/drop.
