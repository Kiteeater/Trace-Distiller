# Copy to .env (gitignored). OpenAI-compatible gateway for pi sessions.
TRACE_DISTILLER_API_BASE=https://mint-alpha.macaron.im/v1
TRACE_DISTILLER_API_KEY=
TRACE_DISTILLER_PROVIDER=macaron
TRACE_DISTILLER_MODEL_HOLE_A=macaron/macaron-v1-coding-venti
TRACE_DISTILLER_MODEL_HOLE_B=macaron/macaron-v1-coding-venti
TRACE_DISTILLER_MODEL_L4=macaron/macaron-v1-coding-venti
# Optional: hard timeout per pi session call (ms). Default 120000.
# For long-only mint (bench --with-l4 --bin long) use >=300000.
# TRACE_DISTILLER_SESSION_TIMEOUT_MS=120000
# TRACE_DISTILLER_SESSION_TIMEOUT_MS=300000
